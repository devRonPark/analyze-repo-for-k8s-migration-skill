{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Executable analysis scenario",
  "type": "object",
  "required": ["cases"],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 8,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "required": [
        "id",
        "query",
        "repository_fixture",
        "report_mode",
        "expected_behavior",
        "forbidden_behavior",
        "repository_snapshot"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "query": {"type": "string", "minLength": 1},
        "repository_fixture": {"type": "string", "minLength": 1},
        "report_mode": {"enum": ["summary", "detailed"]},
        "report_format": {"enum": ["markdown", "json"]},
        "expected_behavior": {"type": "object"},
        "forbidden_behavior": {"type": "object"},
        "repository_snapshot": {"type": "object"}
      }
    }
  }
}
