{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/analyze-repo-for-kubernetes/analysis-result.schema.json",
  "title": "Kubernetes migration analysis result",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "mode"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "mode": {"enum": ["summary", "detailed"]},
    "components": {"type": "array", "items": {"$ref": "#/$defs/component"}},
    "dependencies": {"type": "array", "items": {"$ref": "#/$defs/dependency"}},
    "excluded_items": {"type": "array", "items": {"type": "object"}},
    "missing_inputs": {"type": "array", "items": {"type": "object"}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "design_input_verdict": {
      "enum": ["설계 입력 충분", "추가 정보 필요", "분석 불가"]
    }
  },
  "oneOf": [
    {
      "properties": {"mode": {"const": "summary"}},
      "required": [
        "schema_version",
        "mode",
        "components",
        "excluded_items",
        "missing_inputs",
        "evidence",
        "design_input_verdict"
      ]
    },
    {
      "properties": {"mode": {"const": "detailed"}},
      "required": [
        "schema_version",
        "mode",
        "components",
        "dependencies",
        "excluded_items",
        "missing_inputs",
        "evidence",
        "design_input_verdict"
      ]
    }
  ],
  "$defs": {
    "evidenceStatus": {
      "type": "string",
      "enum": ["확인됨", "추정됨", "미확인", "상충됨"]
    },
    "containerization": {
      "type": "string",
      "enum": [
        "기존 컨테이너 정의 있음",
        "대체 이미지 빌드 방식",
        "컨테이너화 필요",
        "컨테이너화 불필요",
        "미확인"
      ]
    },
    "configurationTiming": {
      "type": "string",
      "enum": [
        "빌드 시점",
        "배포 시점",
        "프로세스 시작 시점",
        "실행 중",
        "관리 시점",
        "미확인"
      ]
    },
    "evidence": {
      "type": "object",
      "required": ["status", "reference"],
      "properties": {
        "status": {"$ref": "#/$defs/evidenceStatus"},
        "reference": {"type": "string", "minLength": 1}
      }
    },
    "component": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "containerization": {"$ref": "#/$defs/containerization"},
        "configuration_timing": {"$ref": "#/$defs/configurationTiming"}
      }
    },
    "dependency": {
      "type": "object",
      "required": ["source", "target"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
      }
    }
  }
}
