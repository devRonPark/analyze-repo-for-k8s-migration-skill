{
  "$schema": "https://opencode.ai/config.json",
  "model": "local-sglang/Qwen/Qwen3.6-35B-A3B-FP8",
  "provider": {
    "local-sglang": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local OpenAI-compatible endpoint",
      "options": {
        "baseURL": "http://172.16.4.249:30000/v1"
      },
      "models": {
        "Qwen/Qwen3.6-35B-A3B-FP8": {
          "name": "Qwen/Qwen3.6-35B-A3B-FP8",
          "options": {
            "reasoningEffort": "none"
          }
        }
      }
    },
    "upstage": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Upstage Solar",
      "options": {
        "baseURL": "https://api.upstage.ai/v1",
        "apiKey": "{env:UPSTAGE_API_KEY}"
      },
      "models": {
        "solar-pro2": {
          "name": "solar-pro2"
        }
      }
    }
  },
  "mcp": {
    "analysis": {
      "type": "local",
      "command": ["{env:ANALYSIS_PIPELINE_PYTHON}", "{env:ANALYSIS_PIPELINE_LAUNCHER}"],
      "enabled": true
    }
  },
  "command": {
    "analyze-repo-for-kubernetes": {
      "template": "현재 저장소를 Kubernetes 이관 관점에서 분석해줘. $ARGUMENTS",
      "description": "현재 저장소를 Kubernetes 이관 관점에서 근거 기반으로 분석합니다.",
      "agent": "kubernetes-migration-analyzer",
      "subtask": false
    }
  },
  "permission": {
    "*": "deny",
    "analysis_*": "allow",
    "grep": "deny",
    "list": "deny",
    "skill": {
      "*": "deny",
      "analyze-repo-for-kubernetes": "allow",
      "analyze-k8s-discovery": "allow",
      "analyze-k8s-execution": "allow",
      "analyze-k8s-relationships": "allow",
      "analyze-k8s-boundaries": "allow",
      "analyze-k8s-contracts": "allow",
      "analyze-k8s-finalize": "allow"
    },
    "edit": "deny",
    "bash": {
      "*": "deny"
    },
    "external_directory": "deny",
    "task": "deny",
    "webfetch": "deny",
    "websearch": "deny",
    "question": "deny"
  }
}
